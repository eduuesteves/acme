{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "rootDir": "src",
    "outDir": "dist",

    "strict": false,
    "esModuleInterop": true,

    "moduleResolution": "node",
    "resolveJsonModule": true,

    "allowJs": true,
    "checkJs": false,

    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
